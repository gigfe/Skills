// Se copia a /backend/drizzle/schema.ts y se adapta (nombre de entidad,
// campos) a lo que pida el módulo. Después de editarlo: `npx drizzle-kit
// generate` genera la migración versionada, `npx drizzle-kit migrate` la aplica.
//
// No confundir con /backend/src/schemas/ (validación Zod de inputs) — esto
// define tablas, aquello valida requests.

import { pgTable, serial, text, integer, timestamp } from 'drizzle-orm/pg-core';

export const users = pgTable('users', {
  id: serial('id').primaryKey(),
  email: text('email').notNull().unique(),
  password: text('password').notNull(), // hash de bcrypt, nunca texto plano
  createdAt: timestamp('created_at').notNull().defaultNow(),
});

export const tasks = pgTable('tasks', {
  id: serial('id').primaryKey(),
  title: text('title').notNull(),
  description: text('description'),
  userId: integer('user_id')
    .notNull()
    .references(() => users.id),
  createdAt: timestamp('created_at').notNull().defaultNow(),
});
