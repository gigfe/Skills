{
  "permissions": {
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.staging)",
      "Read(**/.env.production)",
      "Read(**/.env.api)",
      "Read(**/secrets/**)",
      "Edit(**/.env)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(npx prisma migrate *)",
      "Bash(npx prisma db push *)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(docker compose down *)",
      "Bash(npm install *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-commands.mjs\""
          },
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/verify-before-commit.mjs\"",
            "timeout": 600
          }
        ]
      }
    ]
  }
}
