# Plantilla de variables de entorno de producción — sin valores reales.
# Copiar a .env en el server/target de despliegue, nunca commitear el .env real.

# Server
PORT=4000
NODE_ENV=production

# Postgres (target real: instancia gestionada o Postgres en el mismo VPS)
DATABASE_URL=postgresql://user:password@host:5432/db_name

# Auth
JWT_SECRET=
JWT_EXPIRES_IN=15m

# CORS — orígenes reales permitidos, separados por coma. Nunca abierto ("*") en producción.
ALLOWED_ORIGINS=https://tu-dominio.com

# Frontend (build time — Vite embebe esto en el bundle público, no es secreto)
# Se pasa como build arg (VITE_API_URL) al Dockerfile.frontend, no vive en el .env del backend.
